# Copy to .env.local and fill in. .env.local is git-ignored.

# Supabase (browser-safe publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only keys — used by the /krishi-api endpoints in the Vite dev/preview server
IPGEOLOCATION_API_KEY=
ACCUWEATHER_API_KEY=
GEMINI_API_KEY=
# Optional: override the Gemini model (falls back to gemini-3.7-flash when busy)
GEMINI_MODEL=gemini-3.8-flash
