# MongoDB Atlas Connection String Template
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/arigato_iot?retryWrites=true&w=majority

# Backend Server Port
PORT=5000

# ESP32 Hardware IP Address on Local Network
ESP32_IP=10.110.8.97

# Polling Interval (in milliseconds)
POLL_INTERVAL_MS=3000

# Enable automatic polling of ESP32 (true/false)
AUTO_POLL_ENABLED=true
