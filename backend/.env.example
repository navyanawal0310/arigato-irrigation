# KRISHI SETU Backend Environment Configuration Template
# DO NOT place real passwords in this file. Copy to .env and populate.

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=krishi_setu

# Target ESP32 Field Node API
ESP32_BASE_URL=http://10.110.8.97

# Collector Polling Interval in Seconds (Default: 30s)
TELEMETRY_INTERVAL_SECONDS=30

# API Server Settings
HOST=0.0.0.0
PORT=8000

# Software weather merged into every hardware record (hardware values are never overwritten)
ACCUWEATHER_API_KEY=
# Field coordinates for the API weather lookup (defaults match the ESP32 firmware)
FIELD_LATITUDE=12.9716
FIELD_LONGITUDE=77.5946
API_WEATHER_REFRESH_MINUTES=60
